# Database Configuration
# Choose one:

# PostgreSQL (Production)
DATABASE_URL=postgresql://atlas_user:your_password@localhost:5432/atlas_db

# SQLite (Development)
# DATABASE_URL=sqlite:///./atlas.db

# Database Pool Settings (PostgreSQL only)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
