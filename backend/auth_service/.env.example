# Atlas Authentication Service - Environment Configuration Template

# Application
APP_NAME="Atlas Authentication Service"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security (REQUIRED)
SECRET_KEY="your-super-secret-key-change-this-in-production-use-openssl-rand-hex-32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL="sqlite:///./auth_service.db"

# Server
HOST="0.0.0.0"
PORT=8001
LOG_LEVEL="INFO"
